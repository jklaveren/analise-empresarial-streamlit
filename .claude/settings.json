{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/testes-antes-do-commit.sh\"",
            "timeout": 180,
            "statusMessage": "Rodando a suite antes de deixar commitar..."
          }
        ]
      }
    ]
  }
}
